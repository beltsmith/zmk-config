#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp EQUAL  &kp N1 &kp N2   &kp N3   &kp N4   &kp N5   &kp LBRC        &kp RBRC    &kp N6    &kp N7    &kp N8    &kp N9   &kp N0     &kp MINUS
                &kp TAB    &kp Q  &kp W    &kp E    &kp R    &kp T    &kp LBKT        &kp RBKT    &kp Y     &kp U     &kp I     &kp O    &kp P      &kp RPAR
                &mo LAYERS &kp A  &kp S    &kp D    &kp F    &kp G    &kp LPAR        &kp RPAR    &kp H     &kp J     &kp K     &kp L    &kp SEMI   &kp SQT
                &kp LSHFT  &kp Z  &kp X    &kp C    &kp V    &kp B    &kp B           &kp N       &kp N     &kp M     &kp COMMA &kp DOT  &kp RCTRL  &kp RSHFT
                                 &kp LALT &kp BSLH &kp ESC   &kp BSPC &kp LGUI        &kp RGUI    &kp SPACE &kp RCTRL &kp LBKT  &kp RBKT
                                                   &kp LBRC  &kp LPAR &kp LBKT        &kp RBKT    &kp RPAR  &RBRC

            >;
        };
    };
};