#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 300

#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>


#define CTRL_ESC &mt LCTRL ESC
#define LSPAR &mt LSHFT LPAR
#define RSPAR &mt RSHFT RPAR
#define CSHT &kp LS(LCTRL)
#define CTSLH &mt RCTRL FSLH

// space/bksp shift?
#define LSHBSP &mt LSHFT BSPC
#define RSHSPC &mt RSHFT SPACE

// PAR layers
#define MOVPAR &lt MOVEL LPAR
#define SYMLPAR &lt SYML LPAR
#define SYMRPAR &lt SYMR RPAR

// BKT layers
#define NUMBKT &lt NUM RBKT
#define SYMRBKT &lt SYMR RBKT
#define SYMLBKT &lt SYML LBKT
#define MOVBKT &lt MOVEL LBKT

// PAR gui
#define LGPAR &mt LGUI LPAR
#define RGPAR &mt RGUI RPAR

// BRC alt
#define LABRC &mt LALT LBRC
#define RABRC &mt RALT RBRC

#define COLEL 0
#define QWERTY 1
#define BRACEL 2
#define RUNE 3
#define SYML 4
#define SYMR 5
#define WOW 6
#define MOVEL 7
#define NUM 8
#define GAMES 9
#define TRANS 10
#define LAYERS 11

#define K_LAYERS &mo LAYERS

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&mt {
    flavor = "balanced";
    hold-while-undecided;
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    // require-prior-idle-ms = <150>;
};

&mmv {
    acceleration-exponent = <0>;
};


/ {
    macros {
        file_save: file_save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&kp SPACE &kp F &kp S>;
        };
    };
    behaviours {
    };
    keymap {
        compatible = "zmk,keymap";

        colemak_layer {
            display-name = "Colemak";
            bindings = <
                &kp EQUAL    &kp N1    &kp N2    &kp N3   &kp N4 &kp N5 &kp LBRC    &kp RBRC   &kp N6   &kp N7  &kp N8    &kp N9   &kp N0     &kp MINUS
                &kp TAB      &kp Q     &kp W     &kp F    &kp P  &kp B  &kp GRAVE   &kp RBKT   &kp J    &kp L   &kp U     &kp Y    &kp SEMI   CSHT
                K_LAYERS     &kp A     &kp R     &kp S    &kp T  &kp G  &kp TAB     &kp RPAR   &kp M    &kp N   &kp E     &kp I    &kp O      &kp SQT
                LSPAR        &kp Z     &kp X     &kp C    &kp D  &kp V  &kp EQUAL   &kp MINUS  &kp K    &kp H   &kp COMMA &kp DOT  CTSLH      RSPAR
                                     &kp BSLH &kp LALT CTRL_ESC LSHBSP  &kp LGUI    &kp RGUI    RSHSPC CTRL_ESC &kp LBKT  &kp RBKT
                                                       LABRC    MOVPAR  SYMLBKT     NUMBKT      SYMRPAR RABRC
            >;
        };

        qwerty_layer {
            display-name = "Qwerty";
            bindings = <
                &kp EQUAL  &kp N1 &kp N2   &kp N3   &kp N4   &kp N5  &kp LBRC    &kp RBRC    &kp N6 &kp N7   &kp N8    &kp N9   &kp N0     &kp MINUS
                &kp TAB    &kp Q  &kp W    &kp E    &kp R    &kp T   &kp GRAVE   &kp RBKT    &kp Y  &kp U    &kp I     &kp O    &kp P      CSHT
                &mo LAYERS &kp A  &kp S    &kp D    &kp F    &kp G   &kp TAB     &kp RPAR    &kp H  &kp J    &kp K     &kp L    &kp SEMI   &kp SQT
                LSPAR      &kp Z  &kp X    &kp C    &kp V    &kp B   &kp EQUAL   &kp MINUS   &kp N  &kp M    &kp COMMA &kp DOT  CTSLH      RSPAR
                                  &kp BSLH &kp LALT CTRL_ESC LSHBSP  &kp LGUI    &kp RGUI    RSHSPC CTRL_ESC &kp LBKT  &kp RBKT
                                                    LABRC    MOVPAR  SYMLBKT     NUMBKT      SYMRPAR RABRC

            >;
        };

        brace_layer {
            display-name = "Braces";
            bindings = < //                                                        ||
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &kp LPAR  &kp LBRC  &kp LBKT  &trans    &trans    &kp RBKT &kp RBRC  &kp RPAR  &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                                        &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        rune_layer {
            display-name = "Runescape";
            bindings = <
                &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6           &trans    &kp F6    &kp F7         &kp F8       &kp F9    &kp F10   &trans
                &trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp F7           &trans    &mkp LCLK &mkp LCLK      &trans       &trans    &trans    &trans
                &trans    &trans    &kp W     &trans    &kp N6    &kp N7    &kp F8           &trans    &mkp LCLK &mmv MOVE_DOWN &mmv MOVE_UP &trans    &trans    &trans
                &kp LSHFT &trans    &kp R     &trans    &kp N8    &kp N9    &kp N0           &trans    &mkp LCLK &kp ESC        &trans       &trans    &trans    &kp RSHFT
                                    &trans    &mkp LCLK &trans    &kp SPACE &trans           &trans    &trans    &trans         &trans       &trans
                                                        &trans    &kp RET   &kp LSHFT        &trans    &trans    &trans
            >;
        };

        syml_layer {
            display-name = "Symbols";
            bindings = < //                                                        ||
                &trans    &kp F1    &kp F2    &kp F3   &kp F4    &kp F5     &trans    &trans    &kp F6          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                &trans    &trans    &kp LPAR  &kp LBRC &kp LBKT  &trans     &trans    &trans    &trans          &kp RBKT  &kp RBRC  &kp RPAR  &trans    &trans
                &trans    &kp EXCL  &kp AT    &kp HASH &kp DLLR  &kp PRCNT  &trans    &trans    &kp CARET       &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp SQT
                &trans    &kp TAB   &trans    &trans   &kp TAB   &kp GRAVE  &trans    &trans    &kp BSLH        &kp SQT   &kp EQUAL &trans    &trans    &trans
                                    &trans    &trans   &trans    &kp DEL    &trans    &trans    &trans          &trans    &trans    &trans
                                                       &trans    &trans     &trans    &trans    &kp RET         &trans
            >;
        };

        symr_layer {
            display-name = "Symbols";
            bindings = < //                                                        ||
                &trans    &kp F1    &kp F2    &kp F3   &kp F4    &kp F5     &trans    &trans    &kp F6          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                &trans    &trans    &kp LPAR  &kp LBRC &kp LBKT  &trans     &trans    &trans    &trans          &kp RBKT  &kp RBRC  &kp RPAR  &trans    &trans
                &trans    &kp EXCL  &kp AT    &kp HASH &kp DLLR  &kp PRCNT  &trans    &trans    &kp CARET       &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp SQT
                &trans    &kp TAB   &trans    &trans   &kp TAB   &kp GRAVE  &trans    &trans    &kp BSLH        &kp SQT   &kp EQUAL &trans    &trans    &trans
                                    &trans    &trans   &trans    &kp DEL    &trans    &trans    &kp RSHFT      &trans    &trans    &trans
                                                       &trans    &trans     &trans    &trans    &trans         &trans
            >;
        };

        wow_layer {
            display-name = "Warcraft";
            bindings = <
                &trans    &trans    &trans    &trans   &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans   &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans   &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LSHFT &trans    &trans    &trans   &trans    &trans     &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                    &trans    &kp ESC  &kp LCTRL &kp SPACE  &trans    &trans    &trans    &trans    &trans    &trans
                                                       &kp LALT  &kp LSHFT  &mo MOVEL  &trans    &mo MOVEL  &trans

            >;
        };


        move_layer {
            display-name = "Movement";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans
                &trans    &trans    &trans    &trans    &kp TAB   &trans    &trans    &trans    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans    &trans
                &kp EQUAL &mt LCTRL N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans    &trans    &kp N6    &kp N7    &kp N8    &kp N9     &mt RCTRL N0    &kp MINUS
                                    &trans    &trans    &trans    &trans    &trans    &trans    &kp RET   &kp TAB   &trans    &trans
                                                        &trans    &trans    &trans    &trans    &kp EQUAL &kp MINUS
            >;
        };


        num_layer {
            display-name = "Numbers";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans
                &kp EQUAL &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &trans    &trans    &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &kp MINUS
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans    &trans
                                    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                                        &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        games_layer {
            display-name = "Games";
            bindings = <
                &trans    &trans    &trans    &trans   &trans    &trans     &kp 6     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans   &trans    &trans     &kp Y     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans   &trans    &trans     &kp H     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &kp LSHFT &trans    &trans    &trans   &trans    &trans     &kp N     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                    &kp LALT  &kp ESC  &kp LCTRL &kp SPACE  &trans    &trans    &kp RET   &trans    &trans    &trans
                                                       &kp LALT  &kp LSHFT  &mo MOVEL &trans    &mo MOVEL  &trans
            >;
        };

        trans_layer {
            display-name = "Transparent";
            bindings = < //                                                        ||
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                                                        &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };


        layers_layer {
            display-name = "Layers";
            bindings = <
                &trans    &trans    &trans      &trans      &trans      &trans     &studio_unlock    &studio_unlock    &trans     &trans       &trans    &trans    &trans    &trans
                &trans    &trans    &tog WOW    &trans      &tog RUNE   &trans     &trans            &trans            &trans     &trans       &trans    &trans    &trans    &trans
                &trans    &trans    &trans      &trans      &trans      &tog GAMES &trans            &trans            &trans     &trans       &trans    &trans    &trans    &trans
                &trans    &trans    &trans      &trans      &bt BT_CLR  &trans     &trans            &trans            &trans     &tog QWERTY   &trans    &trans    &trans    &trans
                                    &trans      &bt BT_CLR  &trans      &trans     &trans            &trans            &bt BT_NXT &bt BT_PRV   &trans    &trans
                                                            &bootloader &trans     &sys_reset        &sys_reset        &trans     &bootloader
            >;
        };
    };
};
